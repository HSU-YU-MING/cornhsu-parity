<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 不單獨發套件:引擎會被打進 Cornhsu.Parity 這個 dotnet tool -->
    <IsPackable>false</IsPackable>
    <!-- 引擎是函式庫,不自己帶 Playwright 的 Node:沒設的話 Playwright 的 targets 會帶「建置機器平台」的那份,
         經由 ProjectReference 流進 CLI 的輸出——每個平台一包時,在 ubuntu 上 pack 的 win-x64 包會多夾一份
         linux-x64 Node(實測 +45 MB)。帶哪些平台的 Node 由 Parity.Cli 決定(PlaywrightPlatform)。
         外部傳 -p:PlaywrightPlatform=… 時(release.yml 的 npm job)以那個為準。 -->
    <PlaywrightPlatform Condition="'$(PlaywrightPlatform)' == ''">none</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <!-- 報告契約(report.json 型別、ReportWire、分數、baseline 比對)在 Parity.Report,伺服器只引用那一半 -->
    <ProjectReference Include="..\Parity.Report\Parity.Report.csproj" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- ImageDesignSource 的圖片解碼/取樣。純 managed、跨平台;Six Labors Split License(開源專案免費) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
    <!-- .fig 設計檔的區塊解壓縮(zstd)。純 managed、跨平台、MIT;net8 以上沒有其他相依 -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parity.Tests" />
  </ItemGroup>

</Project>
