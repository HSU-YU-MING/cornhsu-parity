<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Parity.Cli</RootNamespace>
    <AssemblyName>parity</AssemblyName>

    <!-- dotnet tool:使用者敲的是乾淨的 `parity`,套件掛 Cornhsu.* 前綴(規畫書第 9 節)-->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>parity</ToolCommandName>
    <PackageId>Cornhsu.Parity</PackageId>
    <!-- 版本的唯一真相源是 git tag:release 一律以 -p:Version= 覆蓋(見 .github/workflows/release.yml)。
         這裡刻意寫 0.0.0-dev 而不是真版號 —— 寫真版號一定會跟 tag 漂開(0.13.0 vs v0.13.1 就發生過),
         而從原始碼建出來的執行檔會**自稱那個舊版號**;留空則退回 MSBuild 預設的 1.0.0,等於謊稱介面已凍結。
         `parity version` 印的是 InformationalVersion,所以本機建置會顯示 0.0.0-dev+<commit>,一眼看得出不是發行版。 -->
    <Version>0.0.0-dev</Version>
    <!-- 授權 / 作者 / README / icon / SourceLink 等共用中繼資料在根目錄 Directory.Build.props -->
    <Description>Parity — property-level design fidelity checking. Compares the real numeric values of your Figma design and the rendered UI programmatically; runs locally, in CI, or fully on-premises.</Description>
    <!-- NU5111:Playwright 套件內含的 .ps1(非 install 腳本),打包時的無害提醒 -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>

    <!-- Playwright driver 收齊全平台:預設只複製「建置當下平台」的 node,
         release 在 ubuntu runner 上 pack 會做出只含 linux-x64 的包,Windows/macOS 使用者
         裝了直接 Driver not found(0.9.1 踩到)。'all' 不在 targets 的已知平台清單,
         會落到 fallback 把 node\ 底下五個平台全部帶上;工具是給各平台 CI 用的,不挑平台。
         【實驗】改成每個平台一包之後,'all' 只管「不帶 RuntimeIdentifier」的建置(dotnet build/test、
         測試專案的輸出、清空平台清單時的單一套件);平台包由下面依 RuntimeIdentifier 覆寫成單一平台。 -->
    <PlaywrightPlatform>all</PlaywrightPlatform>

    <!-- 【實驗】每個平台一包(.NET 10 SDK 的 RID-specific tool):dotnet pack 一次產出
         一個指標包 Cornhsu.Parity(只有 DotnetToolSettings.xml,列出各平台包)+ 六個平台包
         Cornhsu.Parity.<rid>(各自只帶自己平台的 Playwright Node 與 SQLite 原生檔)。
         RuntimeIdentifiers 也要設:只設 ToolPackageRuntimeIdentifiers 的話,內層 pack 會因為
         assets 檔沒有該 RID 的 target 而 NETSDK1047(實測)。
         清單以外的平台(Alpine 的 linux-musl-*、32 位元 ARM、x86…)裝不到合適的包:Alpine 會被 SDK 配到
         linux-x64、啟動檔起不來(實測)。要不要補 linux-musl-x64/arm64 與 any 後備包是維護者的決定,見 PR 說明。 -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers)</ToolPackageRuntimeIdentifiers>
  </PropertyGroup>

  <!-- 平台包(內層 pack 帶 RuntimeIdentifier)只收自己平台的 Node。win-arm64:Playwright 沒有 ARM 版
       Windows 的 Node,不認得的平台會落回全收;它在 Windows 上一律找 win32_x64\node.exe,Windows 11 ARM 用 x64 模擬跑。
       any / linux-musl-*(目前不在清單裡;CI 的 rid-pack 用 sed 加進清單量大小):Playwright 沒有對應的 Node,
       不帶(none),否則會落回全收、又回到 240 MB。不帶 Node 時 any 包實測 30 MB、musl 包 4 MB -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PlaywrightPlatform>$(RuntimeIdentifier)</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'any' or $(RuntimeIdentifier.StartsWith('linux-musl-'))">none</PlaywrightPlatform>
  </PropertyGroup>

  <!-- 【實驗旋鈕】平台包的部署形式(-p:ParityToolDeployment=…),量大小用,定案後拿掉:
         framework(預設)= 依賴使用者機器上的 .NET 10 runtime(跟現在的套件一樣),只是附上平台的啟動檔;
                            SDK 不設任何東西時產出的就是這種(文件說平台包是 self-contained;實測 Ubuntu 的 10.0.114
                            與微軟官方的 10.0.403 都不是),
                            這裡明寫 SelfContained=false,免得日後 SDK 改預設而跟下面關掉的 runtime pack 下載打架;
         self-contained   = 自帶 .NET runtime;
         trimmed          = 自帶 runtime 並裁掉沒用到的程式(PublishTrimmed)——實測 check 一讀設定檔就崩潰。
       只作用在帶 RuntimeIdentifier 的建置;外部明給 SelfContained(npm job 的 dotnet publish 帶 self-contained 旗標)時以外部為準。 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(ParityToolDeployment)' != 'self-contained' and '$(ParityToolDeployment)' != 'trimmed'">
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and ('$(ParityToolDeployment)' == 'self-contained' or '$(ParityToolDeployment)' == 'trimmed')">
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
  </PropertyGroup>
  <!-- PublishTrimmed 不能只在帶 RID 時設:restore(沒有 RID)時若是 false,裁剪工具包不會被還原,
       內層 pack 就**靜靜不裁**、大小與 self-contained 一模一樣(實測)。外層的指標包由 SDK 強制關掉裁剪。 -->
  <PropertyGroup Condition="'$(ParityToolDeployment)' == 'trimmed'">
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <!-- framework 形式的平台包用不到 runtime pack(只需要各平台的 apphost)。不關掉的話,RuntimeIdentifiers 會讓
       **每一次** restore(開發機、CI 每個 job)多抓六個平台的 .NET 與 ASP.NET Core runtime pack:
       實測冷快取 restore 的 NuGet 快取從 1.3 GB 漲到 2.4 GB。要自帶 runtime 的建置(npm job 的
       帶 self-contained 旗標的 dotnet publish、上面的 self-contained/trimmed 旋鈕)照常下載。 -->
  <PropertyGroup Condition="'$(EnableRuntimePackDownload)' == '' and '$(SelfContained)' != 'true' and '$(ParityToolDeployment)' != 'self-contained' and '$(ParityToolDeployment)' != 'trimmed'">
    <EnableRuntimePackDownload>false</EnableRuntimePackDownload>
  </PropertyGroup>

  <!-- 指標包沒有任何 dll,產出的 snupkg 是空殼(實測 4 個檔、0 個 pdb);不產它,免得 push 時被符號驗證擋下 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(ToolPackageRuntimeIdentifiers)' != ''">
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parity.Engine\Parity.Engine.csproj" />
    <ProjectReference Include="..\Parity.Storage\Parity.Storage.csproj" />
    <InternalsVisibleTo Include="Parity.Tests" />
  </ItemGroup>

  <!-- 第三方授權聲明放在套件根目錄:tool 套件夾帶了 Playwright driver(Apache-2.0,含 NOTICE)、
       Node.js、SQLite 原生檔與 ImageSharp 等,散布時要附上它們的授權。只加在 CLI——
       放進 Directory.Build.props 會讓其他可打包專案也帶上一份不屬於它們的清單。
       npm 平台套件由 npm/prepare.mjs 另外複製同一個檔。 -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- parity serve:Kestrel 本機報告 UI(只綁 127.0.0.1) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
