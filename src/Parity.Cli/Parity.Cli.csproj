<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Parity.Cli</RootNamespace>
    <AssemblyName>parity</AssemblyName>

    <!-- dotnet tool:使用者敲的是乾淨的 `parity`,套件掛 Cornhsu.* 前綴(規畫書第 9 節)-->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>parity</ToolCommandName>
    <PackageId>Cornhsu.Parity</PackageId>
    <!-- 版本的唯一真相源是 git tag:release 一律以 -p:Version= 覆蓋(見 .github/workflows/release.yml)。
         這裡刻意寫 0.0.0-dev 而不是真版號 —— 寫真版號一定會跟 tag 漂開(0.13.0 vs v0.13.1 就發生過),
         而從原始碼建出來的執行檔會**自稱那個舊版號**;留空則退回 MSBuild 預設的 1.0.0,等於謊稱介面已凍結。
         `parity version` 印的是 InformationalVersion,所以本機建置會顯示 0.0.0-dev+<commit>,一眼看得出不是發行版。 -->
    <Version>0.0.0-dev</Version>
    <!-- 授權 / 作者 / README / icon / SourceLink 等共用中繼資料在根目錄 Directory.Build.props -->
    <Description>Parity — property-level design fidelity checking. Compares the real numeric values of your Figma design and the rendered UI programmatically; runs locally, in CI, or fully on-premises.</Description>
    <!-- NU5111:Playwright 套件內含的 .ps1(非 install 腳本),打包時的無害提醒 -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>

    <!-- 'all' 只管「不帶 RuntimeIdentifier」的建置:dotnet build、dotnet run、測試專案的輸出。'all' 不在 Playwright targets 的
         已知平台清單,會落到 fallback 把 node\ 底下五個平台全部帶上(RepoInvariantsTests 看得到五個平台)。
         發出去的平台包由下面依 RuntimeIdentifier 覆寫成單一平台。 -->
    <PlaywrightPlatform>all</PlaywrightPlatform>

    <!-- 每個平台一包(.NET 10 SDK 的 RID-specific tool):單一套件到 2.1.0 已 244 MB,離 nuget.org 250 MB 上限只剩幾 MB。
         dotnet pack 一次產出一個指標包 Cornhsu.Parity(只有 DotnetToolSettings.xml,列出各平台包)+ 九個平台包 Cornhsu.Parity.<rid>:
           - 六個完整平台:帶自己平台的 Playwright Node 與 SQLite 原生檔;
           - linux-musl-x64 / linux-musl-arm64(Alpine)與 any(其他平台的後備):不帶 Node。Playwright 沒有對應的 Node,
             這些平台本來就跑不了要開瀏覽器的指令;留著它們,現在裝得起來的人改了之後才都還裝得起來。
         RuntimeIdentifiers 也要設:只設 ToolPackageRuntimeIdentifiers 的話,內層 pack 會因為 assets 檔沒有該 RID 的 target 而 NETSDK1047(實測)。
         **這份清單可以加、不能減**:拿掉一個平台,那個平台的使用者就裝不起來。
         改清單時 scripts/verify-tool-packages.py 的 EXPECTED_RIDS 要一起改(RepoInvariantsTests 守著)。 -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;linux-musl-x64;linux-musl-arm64;any</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers)</ToolPackageRuntimeIdentifiers>
  </PropertyGroup>

  <!-- 平台包(內層 pack 帶 RuntimeIdentifier)只收自己平台的 Node。
       win-arm64:Playwright 沒有 ARM 版 Windows 的 Node,不認得的平台會落回全收;它在 Windows 上一律找 win32_x64\node.exe,
       Windows 11 ARM 用 x64 模擬跑。any / linux-musl-*:沒有對應的 Node,設 none,否則同樣會落回全收、又回到 240 MB。 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PlaywrightPlatform>$(RuntimeIdentifier)</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'any' or $(RuntimeIdentifier.StartsWith('linux-musl-'))">none</PlaywrightPlatform>
  </PropertyGroup>

  <!-- 平台包依賴使用者機器上的 .NET 10 runtime,跟單一套件時代一樣;不自帶 runtime、也不裁剪。
       官方文件說平台包是 self-contained and trimmed,實測兩者都不是 SDK 的預設(Ubuntu 的 10.0.114、微軟官方的 10.0.403 都是這樣)。
       這裡明寫 SelfContained=false,免得日後 SDK 改預設而跟下面關掉的 runtime pack 下載打架。
       - 不能裁剪:check 一讀設定檔就崩潰(JSON 反射被關掉);開回來之後換 ParityConfig 的建構子被裁掉。
       - 不要自帶 runtime:每包多約 50 MB、.NET 的安全修補要等 Parity 重發、Windows 上的啟動檔還會變成 parity.cmd(見下一段)。
       npm job 的 dotnet publish 帶 self-contained 旗標,命令列的值優先,不受這裡影響。 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <!-- 平台包不附自己的啟動檔(UseAppHost=false),SDK 就把它標成 Runner="dotnet"、安裝時由使用者自己的 SDK 產生啟動檔——
       跟單一套件時代一模一樣。不這麼做的話是 Runner="executable",SDK 在 Windows 上產生的是 parity.cmd(批次檔)而不是 parity.exe:
       bash 叫不到 `parity`(CI 實測 command not found;action.yml 每一步都是 shell: bash),在 Linux/macOS 則是指向包裡
       glibc 啟動檔的 symlink(Alpine 起不來)。見 SDK 的 ShellShimRepository.CreateShim。verify-tool-packages.py 擋著退回 executable。
       自帶 runtime 的建置一定要有啟動檔,所以 SelfContained=true(npm job)不受影響。 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(SelfContained)' != 'true'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!-- 平台包用不到 runtime pack(只需要各平台的 apphost)。不關掉的話,RuntimeIdentifiers 會讓**每一次** restore
       (開發機、CI 每個 job)多抓每個平台的 .NET 與 ASP.NET Core runtime pack:實測冷快取 restore 的 NuGet 快取從 1.3 GB 漲到 2.4 GB。
       要自帶 runtime 的建置(npm job 的 dotnet publish)照常下載。 -->
  <PropertyGroup Condition="'$(EnableRuntimePackDownload)' == '' and '$(SelfContained)' != 'true'">
    <EnableRuntimePackDownload>false</EnableRuntimePackDownload>
  </PropertyGroup>

  <!-- 指標包沒有任何 dll,產出的 snupkg 是空殼(實測 4 個檔、0 個 pdb);不產它,免得 push 時被符號驗證擋下 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parity.Engine\Parity.Engine.csproj" />
    <ProjectReference Include="..\Parity.Storage\Parity.Storage.csproj" />
    <InternalsVisibleTo Include="Parity.Tests" />
  </ItemGroup>

  <!-- 第三方授權聲明放在套件根目錄:tool 套件夾帶了 Playwright driver(Apache-2.0,含 NOTICE)、
       Node.js、SQLite 原生檔與 ImageSharp 等,散布時要附上它們的授權。只加在 CLI——
       放進 Directory.Build.props 會讓其他可打包專案也帶上一份不屬於它們的清單。
       npm 平台套件由 npm/prepare.mjs 另外複製同一個檔。 -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- parity serve:Kestrel 本機報告 UI(只綁 127.0.0.1) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
