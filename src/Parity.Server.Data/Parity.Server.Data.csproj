<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 不上 NuGet:網頁外殼的資料層,隨 Parity.Server 部署 -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <!-- 鐵則「雲端不跑瀏覽器」的結構性保證:只引用報告契約(Parity.Report,零套件相依),
         **不引用 Parity.Engine**——那邊帶著 Playwright 與整個 node driver。RepoInvariantsTests
         會沿 ProjectReference 走完整張圖檢查 -->
    <ProjectReference Include="..\Parity.Report\Parity.Report.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- 與 Parity.Storage 同款 pin(NU1903 修補版 SQLite) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- M1 用 SQLite 開發;M5 定案供應商時換(PostgreSQL 之類),migrations 屆時重生
         ——已知的一次性成本,記在規畫書「動工時的待決區」。 -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parity.Tests" />
  </ItemGroup>

</Project>
